# Server Configuration
PORT=3000
BACKEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/fahara?schema=public
AUTO_MIGRATE_DB=false

# Authentication
JWT_SECRET=your_jwt_secret_here

# Frontend Application Origins (Local vs Production)
# Local development ports: Customer App = 3001, Cafe Owner App = 3002
CUSTOMER_APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
CAFE_FRONTEND_URL=http://localhost:3002
EM_FRONTEND_URL=http://localhost:3002
ADMIN_FRONTEND_URL=http://localhost:3002

# Optional LAN IP override for phone QR scanning tests (e.g. http://192.168.1.7:3001)
# QR_CUSTOMER_APP_URL=http://192.168.1.7:3001

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay / Payment Provider
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com
EMAIL_LOGO_URL=https://example.com/logo.jpg
