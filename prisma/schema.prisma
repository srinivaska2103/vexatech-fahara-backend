generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_number        String          @unique @db.VarChar(30)
  customer_id           String          @db.Uuid
  cafe_id               String          @db.Uuid
  package_id            String?         @db.Uuid
  event_service_id      String?         @db.Uuid
  booking_date          DateTime        @db.Date
  start_time            DateTime        @db.Time(6)
  end_time              DateTime        @db.Time(6)
  hours                 Int
  total_persons         Int
  cafe_amount           Decimal?        @default(0.00) @db.Decimal(10, 2)
  event_service_amount  Decimal?        @default(0.00) @db.Decimal(10, 2)
  food_amount           Decimal?        @default(0.00) @db.Decimal(10, 2)
  decoration_amount     Decimal?        @default(0.00) @db.Decimal(10, 2)
  extra_person_amount   Decimal?        @default(0.00) @db.Decimal(10, 2)
  subtotal              Decimal?        @default(0.00) @db.Decimal(10, 2)
  discount              Decimal?        @default(0.00) @db.Decimal(10, 2)
  gst                   Decimal?        @default(0.00) @db.Decimal(10, 2)
  fahara_service_charge Decimal?        @default(0.00) @db.Decimal(10, 2)
  transaction_fee       Decimal?        @default(0.00) @db.Decimal(10, 2)
  total                 Decimal?        @default(0.00) @db.Decimal(10, 2)
  payment_status        String?         @default("PENDING") @db.VarChar(20)
  booking_status        String?         @default("PENDING") @db.VarChar(20)
  special_request       String?
  event_special_request String?
  inclusions            Json?
  created_at            DateTime?       @default(now()) @db.Timestamp(6)
  updated_at            DateTime?       @default(now()) @db.Timestamp(6)
  cafes                 cafes           @relation(fields: [cafe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users           @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event_services        event_services? @relation(fields: [event_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications         notifications[]
  payments              payments[]
  payment_refunds       payment_refunds[]
  reviews               reviews[]
  booking_tables        booking_tables[]
  loyalty_credit_transactions loyalty_credit_transactions[]
  loyalty_redemptions        loyalty_redemptions[]
  booking_items              booking_items[]
}

model cafe_packages {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id         String    @db.Uuid
  package_name    String    @db.VarChar(255)
  description     String?
  price           Decimal?  @db.Decimal(10, 2)
  minimum_persons Int?
  maximum_persons Int?
  duration_hours  Int?
  cover_image     String?
  gallery         Json?
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  inclusions      Json?
  cafes           cafes     @relation(fields: [cafe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_active], map: "idx_cafe_packages_active")
  @@index([cafe_id], map: "idx_cafe_packages_cafe")
  @@index([package_name], map: "idx_cafe_packages_name")
  @@index([inclusions], map: "idx_cafe_packages_inclusions", type: Gin)
}

model cafes {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                String                @db.Uuid
  name                    String                @db.VarChar(200)
  description             String?
  address                 String?
  city                    String?               @db.VarChar(100)
  latitude                Decimal?              @db.Decimal(10, 8)
  longitude               Decimal?              @db.Decimal(11, 8)
  google_place_id         String?
  google_rating           Decimal?              @default(0) @db.Decimal(2, 1)
  google_reviews_link     String?
  price_per_hour          Decimal?              @db.Decimal(10, 2)
  minimum_persons         Int?
  maximum_persons         Int?
  provides_event_services       Boolean?              @default(false)
  allow_third_party_decoration  Boolean?              @default(true)
  cover_image             String?
  gallery                 Json?
  average_rating          Decimal?              @default(0) @db.Decimal(2, 1)
  total_reviews           Int?                  @default(0)
  category                String?               @db.VarChar(100)
  status                  String?               @default("PENDING") @db.VarChar(20)
  razorpay_account_id         String?               @db.VarChar(100)
  razorpay_linked_account_id  String?               @db.VarChar(100)
  razorpay_account_status     String?               @default("NOT_CREATED") @db.VarChar(30)
  payment_account_provider    String?               @default("RAZORPAY") @db.VarChar(30)
  payment_account_id          String?               @db.VarChar(100)
  bank_verification_status    String?               @default("PENDING") @db.VarChar(30)
  bank_account_last4          String?               @db.VarChar(4)
  bank_account_holder         String?               @db.VarChar(200)
  bank_ifsc                   String?               @db.VarChar(20)
  bank_verified_at            DateTime?             @db.Timestamp(6)
  bank_verification_reference String?               @db.VarChar(100)
  created_at                  DateTime?             @default(now()) @db.Timestamp(6)
  amenities                   Json?
  discounts                   Json?
  is_walking_cafe         Boolean?              @default(false)
  walk_in                 Boolean?              @default(true)
  table_reservation       Boolean?              @default(true)
  event_booking           Boolean?              @default(true)
  event_packages          Boolean?              @default(true)
  event_facilities        Boolean?              @default(true)
  capabilities            Json?
  bookings                bookings[]
  cafe_business_hours     cafe_business_hours[]
  cafe_packages           cafe_packages[]
  users                   users                 @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favorites               favorites[]
  reviews                 reviews[]
  cafe_tables             cafe_tables[]
  cafe_analytics_events   cafe_analytics_events[]

  @@index([city], map: "idx_cafes_city")
  @@index([owner_id], map: "idx_cafes_owner")
  @@index([status], map: "idx_cafes_status")
}

model cafe_analytics_events {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id    String    @db.Uuid
  user_id    String?   @db.Uuid
  session_id String?   @db.VarChar(100)
  event_type String    @db.VarChar(50)
  source     String?   @db.VarChar(50)
  metadata   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  cafes      cafes     @relation(fields: [cafe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([cafe_id], map: "idx_analytics_cafe")
  @@index([event_type], map: "idx_analytics_event_type")
  @@index([created_at], map: "idx_analytics_created_at")
}

model event_services {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  category       String?   @db.VarChar(100)
  service_name   String    @db.VarChar(200)
  description    String?
  price          Decimal?  @db.Decimal(10, 2)
  gallery        Json?
  inclusions     Json?
  average_rating Decimal?  @default(0) @db.Decimal(2, 1)
  total_reviews  Int?      @default(0)
  status         String?   @default("ACTIVE") @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews        reviews[]
  bookings       bookings[]

  @@index([category], map: "idx_event_services_category")
  @@index([status], map: "idx_event_services_status")
  @@index([user_id], map: "idx_event_services_user")
}

model favorites {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  cafe_id    String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  cafes      cafes?    @relation(fields: [cafe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, cafe_id])
}

model media {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type String?   @db.VarChar(30)
  owner_id   String?   @db.Uuid
  file_url   String?
  file_type  String?   @db.VarChar(30)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notifications {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  booking_id        String?   @db.Uuid
  title             String?   @db.VarChar(255)
  message           String?
  notification_type String?   @db.VarChar(30)
  channel           String?   @db.VarChar(20)
  status            String?   @db.VarChar(20)
  sent_at           DateTime? @db.Timestamp(6)
  read_at           DateTime? @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  bookings          bookings? @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model otp_verifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @db.VarChar(255)
  otp        String    @db.VarChar(6)
  expires_at DateTime  @db.Timestamp(6)
  verified   Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model payments {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id         String?          @db.Uuid
  amount             Decimal?         @db.Decimal(10, 2)
  platform_fee       Decimal?         @default(0.00) @db.Decimal(10, 2)
  gst_amount         Decimal?         @default(0.00) @db.Decimal(10, 2)
  payment_gateway    String?          @default("RAZORPAY") @db.VarChar(30)
  payment_provider   String?          @default("RAZORPAY") @db.VarChar(30)
  payment_session_id String?          @db.VarChar(255)
  gateway_order_id   String?          @unique
  gateway_payment_id String?
  provider_order_id  String?          @db.VarChar(100)
  provider_payment_id String?         @db.VarChar(100)
  provider_signature  String?         @db.VarChar(255)
  transaction_id     String?
  payment_method     String?          @db.VarChar(50)
  status             String?          @default("PENDING") @db.VarChar(30)
  payout_status      String?          @default("PENDING") @db.VarChar(20)
  payout_completed_at DateTime?       @db.Timestamp(6)
  paid_at            DateTime?        @db.Timestamp(6)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  updated_at         DateTime?        @default(now()) @db.Timestamp(6)
  bookings           bookings?        @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_splits     payment_splits[]
  payment_refunds    payment_refunds[]
}

model payment_splits {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id           String    @db.Uuid
  vendor_type          String    @db.VarChar(30)
  vendor_id            String?   @db.Uuid
  razorpay_account_id  String?   @db.VarChar(100)
  payment_account_id   String?   @db.VarChar(100)
  provider_transfer_id String?   @db.VarChar(100)
  transfer_status      String?   @default("NOT_CREATED") @db.VarChar(30)
  split_amount         Decimal   @db.Decimal(10, 2)
  settlement_status    String    @default("PENDING") @db.VarChar(30)
  settlement_id        String?   @db.VarChar(100)
  processed_at         DateTime? @db.Timestamp(6)
  settled_at           DateTime? @db.Timestamp(6)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
  payments             payments  @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payment_id], map: "idx_payment_splits_payment")
  @@index([vendor_id], map: "idx_payment_splits_vendor")
  @@index([settlement_status], map: "idx_payment_splits_status")
}

model payment_refunds {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id         String    @db.Uuid
  booking_id         String    @db.Uuid
  refund_amount      Decimal   @db.Decimal(10, 2)
  razorpay_refund_id String?   @db.VarChar(100)
  provider_refund_id String?   @db.VarChar(100)
  provider_reversal_id String? @db.VarChar(100)
  refund_status      String    @default("PENDING") @db.VarChar(30)
  reason             String?
  initiated_by       String?   @db.VarChar(50)
  completed_at       DateTime? @db.Timestamp(6)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
  payments           payments  @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings           bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payment_id], map: "idx_payment_refunds_payment")
  @@index([booking_id], map: "idx_payment_refunds_booking")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
