  @@index([package_id], map: "idx_booking_items_package")
  @@index([inclusion_id], map: "idx_booking_items_inclusion")
  @@index([tier_id], map: "idx_booking_items_tier")
  @@index([item_type], map: "idx_booking_items_type")
