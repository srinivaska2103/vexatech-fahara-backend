  established_year             Int?
  experience_years             Int?      @default(0)
  business_email               String?   @db.VarChar(255)
  business_phone               String?   @db.VarChar(20)
  alternate_phone              String?   @db.VarChar(20)
  website_url                  String?
  instagram_url                String?
  facebook_url                 String?
  youtube_url                  String?
  linkedin_url                 String?
  address_line1                String?   @db.VarChar(255)
  address_line2                String?   @db.VarChar(255)
  city                         String?   @db.VarChar(100)
  state                        String?   @db.VarChar(100)
  country                      String?   @default("India") @db.VarChar(100)
  postal_code                  String?   @db.VarChar(20)
  latitude                     Decimal?  @db.Decimal(10, 8)
  longitude                    Decimal?  @db.Decimal(11, 8)
  service_radius_km            Int?      @default(25)
  verification_status          String?   @default("PENDING") @db.VarChar(20)
  razorpay_account_id          String?   @db.VarChar(100)
  razorpay_linked_account_id   String?   @db.VarChar(100)
  razorpay_account_status      String?   @default("NOT_CREATED") @db.VarChar(30)
  payment_account_provider     String?   @default("RAZORPAY") @db.VarChar(30)
  payment_account_id           String?   @db.VarChar(100)
  bank_verification_status     String?   @default("PENDING") @db.VarChar(30)
  bank_account_last4           String?   @db.VarChar(4)
  bank_account_holder          String?   @db.VarChar(200)
  bank_ifsc                    String?   @db.VarChar(20)
  bank_verified_at             DateTime? @db.Timestamp(6)
  bank_verification_reference  String?   @db.VarChar(100)
  profile_completion           Int?      @default(0)
  average_rating               Decimal?  @default(0) @db.Decimal(2, 1)
  total_reviews                Int?      @default(0)
  total_bookings               Int?      @default(0)
  total_completed_events       Int?      @default(0)
  is_featured                  Boolean?  @default(false)
  is_active                    Boolean?  @default(true)
  created_at                   DateTime? @default(now()) @db.Timestamp(6)
  updated_at                   DateTime? @default(now()) @db.Timestamp(6)
  users                        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([city], map: "idx_event_profile_city")
  @@index([verification_status], map: "idx_event_profile_status")
  @@index([user_id], map: "idx_event_profile_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cafe_business_hours {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id     String    @db.Uuid
