model event_packages {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id          String                    @db.Uuid
  provider_type        String                    @db.VarChar(20)
  event_type           String                    @db.VarChar(100)
  package_name         String                    @db.VarChar(255)
  package_level        String                    @db.VarChar(20)
  description          String?
  base_price           Decimal                   @default(0.00) @db.Decimal(10, 2)
  package_pricing_mode String                    @default("BASE_ONLY") @db.VarChar(30)
  currency             String                    @default("INR") @db.VarChar(10)
  is_active            Boolean                   @default(true)
  created_at           DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                 @default(now()) @db.Timestamp(6)
  inclusions           event_package_inclusions[]

  @@unique([provider_id, event_type, package_level], map: "uq_provider_event_package_level")
  @@index([provider_id], map: "idx_event_packages_provider")
  @@index([provider_type], map: "idx_event_packages_provider_type")
  @@index([event_type], map: "idx_event_packages_event_type")
  @@index([package_level], map: "idx_event_packages_level")
  @@index([is_active], map: "idx_event_packages_active")
}

model event_package_inclusions {
  id             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  package_id     String                          @db.Uuid
  name           String                          @db.VarChar(255)
  category       String?                         @db.VarChar(100)
  description    String?
  pricing_type   String                          @default("FIXED") @db.VarChar(20)
  unit_price     Decimal                         @default(0.00) @db.Decimal(10, 2)
  quantity       Int                             @default(1)
  inclusion_type String                          @default("INCLUDED") @db.VarChar(30)
  is_optional    Boolean                         @default(false)
  is_active      Boolean                         @default(true)
  display_order  Int                             @default(0)
  created_at     DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?                       @default(now()) @db.Timestamp(6)
  event_packages event_packages                  @relation(fields: [package_id], references: [id], onDelete: Cascade)
  tiers          event_package_inclusion_tiers[]

  @@index([package_id], map: "idx_package_inclusions_package")
  @@index([inclusion_type], map: "idx_package_inclusions_type")
  @@index([is_active], map: "idx_package_inclusions_active")
}

model event_package_inclusion_tiers {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inclusion_id             String                   @db.Uuid
  tier_name                String                   @db.VarChar(50) // BASIC, STANDARD, PREMIUM
  description              String?
  pricing_type             String                   @default("FIXED") @db.VarChar(20)
  unit_price               Decimal                  @default(0.00) @db.Decimal(10, 2)
  is_active                Boolean                  @default(true)
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @default(now()) @db.Timestamp(6)
  event_package_inclusions event_package_inclusions @relation(fields: [inclusion_id], references: [id], onDelete: Cascade)

  @@unique([inclusion_id, tier_name], map: "uq_inclusion_tier_name")
  @@index([inclusion_id], map: "idx_inclusion_tiers_inclusion")
  @@index([tier_name], map: "idx_inclusion_tiers_name")
}


