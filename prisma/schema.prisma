  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                   String                     @db.Uuid
  name                      String                     @db.VarChar(150)
  email                     String                     @unique @db.VarChar(255)
  phone                     String?                    @unique @db.VarChar(20)
  password_hash             String?
  dob                       DateTime?                  @db.Date
  gender                    String?                    @db.VarChar(20)
  bio                       String?
  business_name             String?                    @db.VarChar(200)
  gst_number                String?                    @db.VarChar(30)
  bank_name                 String?                    @db.VarChar(150)
  account_holder            String?                    @db.VarChar(150)
  account_number            String?                    @db.VarChar(50)
  ifsc_code                 String?                    @db.VarChar(20)
  upi_id                    String?                    @db.VarChar(100)
  address                   String?
  city                      String?                    @db.VarChar(100)
  state                     String?                    @db.VarChar(100)
  country                   String?                    @db.VarChar(100)
  pincode                   String?                    @db.VarChar(15)
  profile_image             String?
  description               String?
  email_verified            Boolean?                   @default(false)
  owner_onboarding_completed Boolean?                  @default(false)
  owner_onboarding_completed_at DateTime?               @db.Timestamp(6)
  status                    String?                    @default("ACTIVE") @db.VarChar(20)
  created_at                DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                  @default(now()) @db.Timestamp(6)
  bookings                  bookings[]
  cafes                     cafes[]
  event_business_hours      event_business_hours[]
  event_management_profiles event_management_profiles?
  event_services            event_services[]
  audit_logs                audit_logs[]        @relation("audit_logs_admin")
  security_sessions         security_sessions[] @relation("security_sessions_user")
  login_history             login_history[]     @relation("login_history_user")
  favorites                 favorites[]
  notifications             notifications[]
  reviews                   reviews[]
  cafe_analytics_events     cafe_analytics_events[]
  user_devices              user_devices[]
  customer_notes_as_customer customer_notes[] @relation("customer_notes_customer")
  customer_notes_as_owner    customer_notes[] @relation("customer_notes_owner")
  user_loyalty_accounts     user_loyalty_accounts?
  loyalty_credit_transactions loyalty_credit_transactions[]
  loyalty_redemptions        loyalty_redemptions[]
  roles                     roles                      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model event_business_hours {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  day_of_week String    @db.VarChar(10)
  open_time   DateTime? @db.Time(6)
  close_time  DateTime? @db.Time(6)
