model security_sessions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  device         String?   @db.VarChar(100)
  os             String?   @db.VarChar(50)
  browser        String?   @db.VarChar(50)
  ip_address     String?   @db.VarChar(45)
  location       String?   @db.VarChar(100)
  is_current     Boolean?  @default(true)
  last_active_at DateTime? @default(now()) @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  user           users     @relation("security_sessions_user", fields: [user_id], references: [id], onDelete: Cascade)
}

model login_history {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?   @db.Uuid
  email          String?   @db.VarChar(255)
  status         String    @db.VarChar(20)
  ip_address     String?   @db.VarChar(45)
  device         String?   @db.VarChar(100)
  location       String?   @db.VarChar(100)
  reason         String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  user           users?    @relation("login_history_user", fields: [user_id], references: [id], onDelete: Cascade)
}

model cafe_tables {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id                 String                    @db.Uuid
  table_number            String                    @db.VarChar(50)
  capacity                Int                       @default(2)
  table_type              String?                   @default("2 Seater") @db.VarChar(50)
  location                String?                   @default("Indoor") @db.VarChar(50)
  status                  String?                   @default("ACTIVE") @db.VarChar(20)
  is_combinable           Boolean?                  @default(false)
  description             String?
  position_x              Float?                    @default(0)
  position_y              Float?                    @default(0)
  rotation                Int?                      @default(0)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  cafes                   cafes                     @relation(fields: [cafe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  combinations_as_primary cafe_table_combinations[] @relation("primary_table")
  combinations_as_combined cafe_table_combinations[]@relation("combined_table")
  booking_tables          booking_tables[]

  @@unique([cafe_id, table_number], map: "uq_cafe_table_number")
  @@index([cafe_id], map: "idx_cafe_tables_cafe")
  @@index([status], map: "idx_cafe_tables_status")
}

model cafe_table_combinations {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cafe_id           String      @db.Uuid
  table_id          String      @db.Uuid
  combined_table_id String      @db.Uuid
  created_at        DateTime?   @default(now()) @db.Timestamp(6)
  primary_table     cafe_tables @relation("primary_table", fields: [table_id], references: [id], onDelete: Cascade)
  combined_table    cafe_tables @relation("combined_table", fields: [combined_table_id], references: [id], onDelete: Cascade)

  @@unique([table_id, combined_table_id], map: "uq_table_combination")
  @@index([cafe_id], map: "idx_table_combinations_cafe")
  @@index([table_id], map: "idx_table_combinations_primary")
}

model booking_tables {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String      @db.Uuid
  table_id    String      @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  bookings    bookings    @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  cafe_tables cafe_tables @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@unique([booking_id, table_id], map: "uq_booking_table")
  @@index([booking_id], map: "idx_booking_tables_booking")
  @@index([table_id], map: "idx_booking_tables_table")
}

model user_loyalty_accounts {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String                        @unique @db.Uuid
  credit_balance            Int                           @default(0)
  lifetime_credits_earned   Int                           @default(0)
  lifetime_credits_redeemed Int                           @default(0)
  status                    String                        @default("ACTIVE") @db.VarChar(20)
  created_at                DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                     @default(now()) @db.Timestamp(6)
  users                     users                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions              loyalty_credit_transactions[]
  redemptions               loyalty_redemptions[]
}

model loyalty_credit_transactions {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String                @db.Uuid
  loyalty_account_id String                @db.Uuid
  booking_id         String?               @db.Uuid
  type               String                @db.VarChar(20) // EARN, REDEEM, REVERSE, ADJUSTMENT
  credits            Int
  balance_before     Int
  balance_after      Int
  reason             String?
  status             String                @default("COMPLETED") @db.VarChar(20) // PENDING, COMPLETED, REVERSED
  created_at         DateTime?             @default(now()) @db.Timestamp(6)
  users              users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  loyalty_account    user_loyalty_accounts @relation(fields: [loyalty_account_id], references: [id], onDelete: Cascade)
  bookings           bookings?             @relation(fields: [booking_id], references: [id], onDelete: SetNull)

  @@unique([user_id, booking_id, type], map: "uq_user_booking_type_loyalty")
  @@index([user_id], map: "idx_loyalty_tx_user")
  @@index([loyalty_account_id], map: "idx_loyalty_tx_account")
  @@index([booking_id], map: "idx_loyalty_tx_booking")
}

model loyalty_redemptions {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String                @db.Uuid
  loyalty_account_id String                @db.Uuid
  booking_id         String?               @db.Uuid
  credits_used       Int
  rupee_value        Decimal               @db.Decimal(10, 2)
  status             String                @default("COMPLETED") @db.VarChar(20) // PENDING, COMPLETED, CANCELLED
  created_at         DateTime?             @default(now()) @db.Timestamp(6)
  updated_at         DateTime?             @default(now()) @db.Timestamp(6)
  users              users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  loyalty_account    user_loyalty_accounts @relation(fields: [loyalty_account_id], references: [id], onDelete: Cascade)
  bookings           bookings?             @relation(fields: [booking_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_loyalty_redemption_user")
  @@index([loyalty_account_id], map: "idx_loyalty_redemption_account")
}

model booking_items {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String    @db.Uuid
  provider_type   String    @db.VarChar(20)
  item_type       String    @db.VarChar(30)
  provider_id     String?   @db.Uuid
  package_id      String?   @db.Uuid
  inclusion_id    String?   @db.VarChar(255)
  tier_id         String?   @db.VarChar(255)
  item_name       String    @db.VarChar(255)
  package_name    String?   @db.VarChar(255)
  package_level   String?   @db.VarChar(20)
  tier_name       String?   @db.VarChar(100)
  pricing_type    String    @db.VarChar(20)
  unit_price      Decimal   @default(0.00) @db.Decimal(10, 2)
  quantity        Int       @default(1)
