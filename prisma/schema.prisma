model users {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                   String                     @db.Uuid
  name                      String                     @db.VarChar(150)
  email                     String                     @unique @db.VarChar(255)
  phone                     String?                    @unique @db.VarChar(20)
  password_hash             String?
  dob                       DateTime?                  @db.Date
  gender                    String?                    @db.VarChar(20)
  bio                       String?
  business_name             String?                    @db.VarChar(200)
  gst_number                String?                    @db.VarChar(30)
  bank_name                 String?                    @db.VarChar(150)
  account_holder            String?                    @db.VarChar(150)
  account_number            String?                    @db.VarChar(50)
  ifsc_code                 String?                    @db.VarChar(20)
  upi_id                    String?                    @db.VarChar(100)
  address                   String?
  city                      String?                    @db.VarChar(100)
  state                     String?                    @db.VarChar(100)
  country                   String?                    @db.VarChar(100)
  pincode                   String?                    @db.VarChar(15)
  profile_image             String?
  description               String?
