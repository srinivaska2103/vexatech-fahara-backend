model customer_notes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id String    @db.Uuid
  owner_id    String    @db.Uuid
  note        String
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  
  users_customer users  @relation("customer_notes_customer", fields: [customer_id], references: [id], onDelete: Cascade)
  users_owner    users  @relation("customer_notes_owner", fields: [owner_id], references: [id], onDelete: Cascade)
}

model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String?   @db.Uuid
  action      String    @db.VarChar(100)
  entity      String    @db.VarChar(100)
  entity_id   String?   @db.VarChar(100)
  ip_address  String?   @db.VarChar(45)
  metadata    Json?
  status      String?   @db.VarChar(20) @default("success")
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  admin       users?    @relation("audit_logs_admin", fields: [admin_id], references: [id], onDelete: SetNull)
}

model security_sessions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  device         String?   @db.VarChar(100)
  os             String?   @db.VarChar(50)
  browser        String?   @db.VarChar(50)
  ip_address     String?   @db.VarChar(45)
  location       String?   @db.VarChar(100)
  is_current     Boolean?  @default(true)
  last_active_at DateTime? @default(now()) @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  user           users     @relation("security_sessions_user", fields: [user_id], references: [id], onDelete: Cascade)
}

model login_history {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?   @db.Uuid
  email          String?   @db.VarChar(255)
  status         String    @db.VarChar(20)
  ip_address     String?   @db.VarChar(45)
  device         String?   @db.VarChar(100)
  location       String?   @db.VarChar(100)
  reason         String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  user           users?    @relation("login_history_user", fields: [user_id], references: [id], onDelete: Cascade)
}
